# Lightweight container dedicated to OPC-UA Demo Server
FROM python:3.12-slim

WORKDIR /app

# Install compilation toolchain for cryptographic dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

# Install asyncua with timeout and retry resilience
RUN pip install \
    --index-url https://pypi.org/simple/ \
    --timeout 300 \
    --retries 5 \
    asyncua==1.1.5

# Copy standalone demo server entrypoint
COPY opcua_demo_server.py .

EXPOSE 4840

CMD ["python", "opcua_demo_server.py", "--port", "4840"]
